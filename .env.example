# Valeurs factices pour un lancement local. Ne jamais commiter de .env réel.
# Sur Clever Cloud, POSTGRESQL_ADDON_URI est injectée par l'add-on lié : ne pas poser DATABASE_URL.
DATABASE_URL=postgres://postgres@localhost:5432/suivi_patient_hds
PG_SSL=disable
PRATICIEN_LOGIN=admin
PRATICIEN_PASSWORD=admin
SEED_DEMO=true
PORT=8080
# APP_ENV=production   # impose HTTPS, cookie Secure, mot de passe de 12 caractères et TLS vers la base
# DB_POOL_MAX=2        # connexions par instance (45 au plus sur xxs_sml, toutes instances confondues)
